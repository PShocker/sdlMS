---
# Google C++ style formatting for the sdlMS project.
Language: Cpp
BasedOnStyle: Google
Standard: Latest

# Google style is 2-space indented, 80 columns.
ColumnLimit: 80
IndentWidth: 2
TabWidth: 2
UseTab: Never

# Google style binds the asterisk to the type: `int* p`.
DerivePointerAlignment: false
PointerAlignment: Left

# `namespace foo { ... }  // namespace foo`
FixNamespaceComments: true

# Include ordering: the related header first, then project headers, then
# other libraries, then C/C++ standard headers.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeIsMainRegex: '(Test)?$'
IncludeCategories:
  - Regex: '^"src/'
    Priority: 1
    SortPriority: 1
  - Regex: '^"[a-z_]+\.(h|hpp)"$'
    Priority: 2
    SortPriority: 2
  - Regex: '^<(SDL3|SDL|uv|flatbuffers|av|libav|libsw|ft2build|freetype|wz)'
    Priority: 3
    SortPriority: 3
  - Regex: '^<'
    Priority: 4
    SortPriority: 4
  - Regex: '.*'
    Priority: 5
    SortPriority: 5

ReflowComments: true
SpacesBeforeTrailingComments: 2
MaxEmptyLinesToKeep: 2
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
IndentCaseLabels: true
NamespaceIndentation: None
AccessModifierOffset: -1
EmptyLineBeforeAccessModifier: LogicalBlock
