include "common.fbs";

namespace fbs;      // 定义命名空间
// 心跳包
table ClientHeartbeat {
}

table ClientScene {
    fade:bool;
    map_id:uint32;
    character:Character;
}

table ClientCharacterAttack {
    payload:[CharacterAttack];
}

table ClientCharacterSkill {
    ski_id:uint32;
    ski_lv:uint8;
    payload:[CharacterSkill];
    x:int32;
    y:int32;
    flip:bool;
}

table ClientCharacterBall {
    payload:CharacterBall;
}

table ClientMobAttack {
    map_id:uint32;
    payload:Attack;
}

table ClientCharacterChat {
    map_id:uint32;
    payload:CharacterChat;
}

// 宠物状态（095 CPet）：进图/切换/喂食后上报，供其他玩家看到自己的宠物。
table ClientCharacterPet {
    map_id:uint32;
    pet:PetSave;
}

// 宠物动作（095 CPet::DoAction 的 bSend 包）：命令/喂食时播的动作 + 气泡台词。
table ClientCharacterPetAction {
    map_id:uint32;
    action:string;
    chat:[uint16];
}

// 宠物位置/动画同步（095 CPet 的移动包）：主人客户端上报宠物的位置和当前帧。
table ClientCharacterPetMove {
    map_id:uint32;
    x:float;
    y:float;
    page:uint8;
    flip:bool;
    action:string;
    ani_index:uint32;
}

table ClientCharacterDrop {
    map_id:uint32;
    payload:Drop;
}

table ClientCharacter {
    map_id:uint32;
    payload:Character;
}

table ClientCharacterPick {
    map_id:uint32;
    random_id:uint64;
    pet_index:int8;
}

table ClientCharacterInfo {
   payload:uint64;
}

table ClientCharacterTrade {
   step:uint8;
   to_id:uint64;
   payload:[ItemUnion];
}

table ClientCharacterState {
    map_id:uint32;
    payload:[State];
}

table ClientCharacterMv {
    map_id:uint32;
    payload:Movement;
}

table ClientCharacterFlip {
    map_id:uint32;
    payload:Flip;
}

table ClientCharacterAction {
    map_id:uint32;
    payload:Action;
}

table ClientCharacterDie {
    map_id:uint32;
    payload:Die;
}

table ClientCharacterFc {
    map_id:uint32;
    payload:Face;
}

table ClientCharacterParty {
    step:uint8;
    to_id:uint64;
}

table ClientReactor {
    map_id:uint32;
    payload:Reactor;
}

table ClientCharacterLvUp {
    map_id:uint32;
}

table ClientCreateMob {
    map_id:uint32;
    mobs:[Mob];
}

table ClientTrapAttack {
    map_id:uint32;
    payload:Attack;
}

table ClientDropFade {
    map_id:uint32;
    random_id:[uint64];
}

table ClientRSkill {
    map_id:uint32;
    payload:[RSkill];
}

table ClientMobDebuff {
    map_id:uint32;
    payload:[MobDebuff];
}

table ClientCreateDrop {
    map_id:uint32;
    delay:uint64;
    drops:[Drop];
}