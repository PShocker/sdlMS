include "client.fbs";
include "server.fbs";

namespace fbs;      // 定义命名空间

// 联合体：包含所有消息类型
union NetPayload {
    ClientHeartbeat,
    ClientScene,
    ClientCharacterMv,
    ClientCharacterFlip,
    ClientCharacterAction,
    ClientCharacterDie,
    ClientCharacterFc,
    ClientCharacterAttack,
    ClientCharacterSkill,
    ClientCharacterBall,
    ClientCharacterState,
    ClientMobAttack,
    ClientCharacterChat,
    ClientCharacterDrop,
    ClientCharacter,
    ClientCharacterPick,
    ClientCharacterInfo,
    ClientCharacterTrade,
    ClientCharacterParty,
    ClientReactor,
    ClientCharacterLvUp,
    ClientCreateMob,
    ClientTrapAttack,
    ClientDropFade,
    ClientRSkill,
    ClientCreateDrop,
    ClientMobDebuff,
    ServerHeartbeat,
    ServerScene,
    ServerCharacterIn,
    ServerCharacterOut,
    ServerCharacterMv,
    ServerCharacterFlip,
    ServerCharacterAction,
    ServerCharacterDie,
    ServerCharacterFc,
    ServerCharacterAttack,
    ServerCharacterSkill,
    ServerCharacterBall,
    ServerCharacterChat,
    ServerCharacterDrop,
    ServerCharacter,
    ServerMobMv,
    ServerMobFlip,
    ServerMobAction,
    ServerMobState,
    ServerMobEvent,
    ServerMobAttack,
    ServerCharacterPick,
    ServerCharacterInfo,
    ServerCharacterTrade,
    ServerCharacterParty,
    ServerCharacterState,
    ServerDropFade,
    ServerReactor,
    ServerReactorDrop,
    ServerCharacterLvUp,
    ServerCreateMob,
    ServerTrapAttack,
    ServerRSkill,
    ServerCreateDrop,
    ServerMobDebuff,
    // 宠物状态同步（追加在末尾，避免已有 union 编号变化）
    ClientCharacterPet,
    ServerCharacterPet,
    ClientCharacterPetAction,
    ServerCharacterPetAction,
    ClientCharacterPetMove,
    ServerCharacterPetMove,
    // 小游戏（五子棋）房间（追加在末尾）
    ClientCharacterMinigame,
    ServerCharacterMinigame,
    // 人物摆摊（追加在末尾）
    ClientCharacterShop,
    ServerCharacterShop,
    // MapleChat 聊天室（追加在末尾）
    ClientCharacterMessenger,
    ServerCharacterMessenger,
    // 天气道具（追加在末尾）
    ClientCharacterWeather,
    ServerCharacterWeather,
    // 好友上线/下线通知（追加在末尾）
    ServerFriendOnline,
}
// 统一的网络包（最外层包装）
table NetPacket {
    payload:NetPayload;          // 实际数据
}

root_type NetPacket;