namespace fbs;      // 定义命名空间

table LifeState{
    x:float;
    y:float;

    action:string;
    action_index:uint32;
    action_animate:bool;

    page:uint8;
    flip:bool;
    fh:int16;
}

table CharacterAppearance{
    body:uint32;
    head:uint32;
    face:uint32;
    hair:uint32;
    ear:string;
}


table Character{
    name:[uint16];
    fame:int32;
    job:string;
    level:uint32;

    state:LifeState;
    appearance:CharacterAppearance;
    face:Face;

    equips:[Equip];
    decos:[Deco];

    states:[State];

    // 人物唯一标识：高32位=创建时间戳(秒)，低32位=随机数。
    id:uint64;
}

table Movement{
    x1:float;
    y1:float;

    x2:float;
    y2:float;

    time:uint32;
    page:uint8;
}

table Flip{
    flip:bool;
}

table Action{
    action:string;
    action_index:uint32;
    action_animate:bool;
}

table Attack{
    delay:uint64;
    num:uint64;
    x:float;
    y:float;
    type:uint8;
    knockback:float;
    // 0 表示默认速度；Rush 等技能可传 >1 的倍率。
    knockback_speed:float;
}

table Die{
    x:float;
    y:float;
}

table Ball{
    x1:float;
    y1:float;

    x2:float;
    y2:float;

    speed:float;

    mob_index:uint32;
    delay:uint64;
    page:uint8;
}

table CharacterBall{
    path:string;
    ball:Ball;
}

table CharacterAttack{
    mob_index:uint32;
    attack:Attack;
    effect:string;
    sound:string;
    left:bool;
}

table CharacterSkill{
    delay:uint64;
    mob:uint32;
    player:uint64;
    x:float;
    y:float;
}

table Player{
    client_id:uint64;
    character:Character;
}

table Mob{
    mob_index:uint32;
    mob_id:uint32;
    mob_hp:int64;
    state:LifeState;
    states:[State];
}

table Face{
    face_action:string;
}

enum ChatEnum : int8 {
    MAP,
}

table CharacterChat{
    type:ChatEnum;
    payload:[uint16];
}

table EquipScroll{
    scroll_id:uint32;
    success:bool;
}

table Equip{
    equip_id:uint32;
    scroll:[EquipScroll];
}

table Deco{
    deco_id:uint32;
}

table Item{
    item_id:uint32;
    item_num:uint32;
}

union ItemUnion {
    Equip,
    Item,
}

table Drop{
    random_id:uint64;
    drop:ItemUnion;

    x1:float;
    y1:float;

    x2:float;
    y2:float;

    page:uint8;
}

enum StateEnum : int8 {
    HP,
    MAX_HP,
    ITEM_USE,
    BUFF_SKILL,
    BUFF_ITEM,
    DEBUFF,
}

table State{
    state: StateEnum;
    val:int64;
    sub_val:int64;
    time:uint64;
    delay:uint64;
}

table Reactor{
    reactor_index:uint8;
    state:uint8;
    action:string;
    delay:uint64;
}

table RSkillPortal{ 
    goal_x:float;
    goal_y:float;
    goal_map:uint64;
}

table RSkill{ //RegionSkill
    client_id:uint64;
    ski_id:uint32;
    ski_lv:uint8;
    x:float;
    y:float;
    flip:bool;
    page:uint8;
    start:uint64;
    end:uint64;
    val:int64;

    portal:RSkillPortal;
}

table MobDebuff{
    mob_index:uint32;
    payload:State;
}

table APSave{
    hp_ap:uint32;
    mp_ap:uint32;
   
    str_ap:uint32;
    dex_ap:uint32;
    int_ap:uint32;
    luk_ap:uint32;
}

table SPSave{
   id:uint32;
   val:uint32;
}

table PackageSave{
   index:uint32;
   data:ItemUnion;
   expire:uint64;
}

table QuestMobSave{
    mob_id:uint32;
    mob_num:uint32;
}

table QuestSave{
   id:string;
   index:uint8;
   type:uint8;
   mob:[QuestMobSave];
}

table KeyConfigSave{
    scan_code:uint16;
    type:string;
    val:string;
    sub_val:string;
}

table CraftSave{
    type:uint8;
    level:uint8;
    exp:uint32;
}

table QuestAlarmSave{
    id:string;
}

// 宠物（095 CPet）：item_id 是宠物道具 id（05000000~），
// name 是宠物名字（UTF-16），fullness 是饱食度 0~100。
table PetSave{
    item_id:uint32;
    name:[uint16];
    level:uint8;
    fullness:uint8;
    // 亲密度（095 CPet：宠物食品 spec/incTameness 增加，宠物信息窗口显示）
    closeness:uint8;
    active:bool;
}

table CharacterSave{
    character:Character;
    ap:APSave;
    sp:[SPSave];
    remain_ap:uint32;
    remain_sp:[uint32];
    package:[PackageSave];
    meso:uint64;
    map_id:uint32;
    portal_id:uint32;
    return_map_id:uint32;
    hp:uint32;
    mp:uint32;
    exp:uint64;
    quest:[QuestSave];
    quest_alarm:[QuestAlarmSave];
    key:[KeyConfigSave];
    craft:[CraftSave];
    // 旧版单宠物存档（兼容读取，新存档写 pets）
    pet:PetSave;
    // 拥有的全部宠物状态（095：每个宠物道具都有独立的等级/饱食度/名字）
    pets:[PetSave];
    // 好友列表（用人物唯一 id 标识）
    friends:[FriendSave];
}

// 好友存档：id 为好友的人物唯一标识（高32位创建时间戳+低32位随机数）
table FriendSave{
    id:uint64;
    name:[uint16];
}

table PlayerSave{
    data:[CharacterSave];
    storage:[ItemUnion];
    // 选项窗口：key = "<tab>/<element>"
    options:[OptionSave];
}

table OptionSave{
    key:string;
    val:int32;
}

table GameSave{
    username:string;
    data:PlayerSave;
}

// 摆摊商品（095 CPersonalShopDlg 的 Goods 条目）：client/server 共用。
table ShopGoods {
    item_id:uint64;      // 8 位道具 id
    num:uint32;          // 上架数量
    price:uint64;        // 单价
}