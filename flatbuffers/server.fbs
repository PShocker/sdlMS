include "common.fbs";

namespace fbs;      // 定义命名空间

table ServerHeartbeat {
}

table ServerScene {
    client_id:uint64;
    time:uint64;
    map_id:uint32;
    fade:bool;
    
    players:[Player];
    mobs:[Mob];
    drops:[Drop];
    reactors:[Reactor];
    region_skill:[RSkill];
}

table ServerCharacterIn {
    player:Player;
}

table ServerCharacterOut {
    client_id:uint64;
}

table ServerMobMv {
    mob_index:uint32;
    payload:Movement;
}

table ServerMobFlip {
    mob_index:uint32;
    payload:Flip;
}

table ServerMobAction {
    mob_index:uint32;
    payload:Action;
}

table ServerMobState {
    mob_index:uint32;
    payload:[State];
}

table ServerMobDie {
    client_id:uint64;
    mob_index:uint32;
}

table ServerMobDrop {
    mob_index:uint32;
    drop:[Drop];
}

// 怪物攻击命中玩家：client_id 是被命中的一方
// flags 位：1 = 固定打掉到 1 HP（deadlyAttack），2 = 魔法伤害强制为 1（mpBurn）
table ServerMobAttackPlayer {
    mob_index:uint32;
    client_id:uint64;
    payload:Attack;
    flags:uint8;
}

// 怪物打怪物（被迷惑的怪互殴）：mob_index 是受害者，from_index 是攻击者。
// 伤害由服务端结算，payload 只用于客户端飘字表现。
table ServerMobHitMob {
    mob_index:uint32;
    from_index:uint32;
    payload:Attack;
}

// 怪物特效（v95 sEffect / sHit / sBall / areaWarning / MobSkill effect）：
// kind 0 = Mob.wz（path 形如 "<mobid>.img/attack1/info/effect"），
// kind 1 = Skill.wz（path 形如 "MobSkill/120.img/level/1/effect"）。
// x/y 是世界坐标，delay 是从收到事件算起的延迟（毫秒）。
// move_ms > 0 表示飞行体（子弹）：从 (x,y) 匀速移动到 (x2,y2)，
// 期间帧循环播放，到点后销毁。
table ServerMobEffect {
    mob_index:uint32;
    kind:uint8;
    path:string;
    x:float;
    y:float;
    x2:float;
    y2:float;
    move_ms:uint64;
    flip:bool;
    delay:uint64;
}

union MobEventUnion {
    ServerMobMv,
    ServerMobFlip,
    ServerMobAction,
    ServerMobState,
    ServerMobDie,
    ServerMobDrop,
    ServerMobAttackPlayer,
    ServerMobHitMob,
    ServerMobEffect,
}

table ServerMobEvent {
    map_id:uint32;
    payload:[MobEventUnion];
}

table ServerCharacterAttack {
    client_id:uint64;
    payload:[CharacterAttack];
}

table ServerCharacterSkill {
    ski_id:uint32;
    ski_lv:uint8;
    client_id:uint64;
    payload:[CharacterSkill];
    x:int32;
    y:int32;
    flip:bool;
}

table ServerCharacterBall {
    client_id:uint64;
    payload:CharacterBall;
}

table ServerMobAttack {
    client_id:uint64;
    payload:Attack;
}

table ServerCharacterChat {
    client_id:uint64;
    name:[uint16];
    payload:CharacterChat;
}

table ServerCharacterDrop {
    client_id:uint64;
    payload:Drop;
}

table ServerCharacter {
    client_id:uint64;
    payload:Character;
}

table ServerCharacterPick {
    client_id:uint64;
    random_id:uint64;
    pet:bool;
    pet_index:int8;
}

table ServerCharacterInfo {
   payload:Character;
}

table ServerCharacterTrade {
   step:uint8;
   player:Player;
   payload:[ItemUnion];
}


table ServerCharacterMv {
    client_id:uint64;
    payload:Movement;
}

table ServerCharacterFlip {
    client_id:uint64;
    payload:Flip;
}

table ServerCharacterAction {
    client_id:uint64;
    payload:Action;
}

table ServerCharacterDie {
    client_id:uint64;
    payload:Die;
}

table ServerCharacterFc {
    client_id:uint64;
    payload:Face;
}

table ServerCharacterParty {
    step:uint8;
    to_id:uint64;
    
    players:[Player];
}

table ServerCharacterState {
    client_id:uint64;
    payload:[State];
}

table ServerDropFade {
    drop_ids:[uint64];
}

table ServerReactor {
    payload:Reactor;
}

table ServerReactorDrop {
    payload:[Drop];
}

table ServerCharacterLvUp {
    client_id:uint64;
}

table ServerCreateMob {
    mobs:[Mob];
}

table ServerTrapAttack {
    client_id:uint64;
    payload:Attack;
}

table ServerRSkill {
    payload:[RSkill];
}

table ServerMobDebuff {
    payload:[MobDebuff];
}

table ServerCreateDrop {
    payload:[Drop];
}