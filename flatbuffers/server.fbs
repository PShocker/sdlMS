include "common.fbs";

namespace fbs;      // 定义命名空间

table ServerHeartbeat {
}

table ServerScene {
    client_id:uint64;
    time:uint64;
    map_id:uint32;
    fade:bool;
    
    players:[Player];
    mobs:[Mob];
    drops:[Drop];
    reactors:[Reactor];
    region_skill:[RSkill];
}

table ServerCharacterIn {
    player:Player;
}

table ServerCharacterOut {
    client_id:uint64;
}

table ServerMobMv {
    mob_index:uint32;
    payload:Movement;
}

table ServerMobFlip {
    mob_index:uint32;
    payload:Flip;
}

table ServerMobAction {
    mob_index:uint32;
    payload:Action;
}

table ServerMobState {
    mob_index:uint32;
    payload:[State];
}

table ServerMobDie {
    client_id:uint64;
    mob_index:uint32;
}

table ServerMobDrop {
    mob_index:uint32;
    drop:[Drop];
}

// 怪物攻击命中玩家：client_id 是被命中的一方
// flags 位：1 = 固定打掉到 1 HP（deadlyAttack），2 = 魔法伤害强制为 1（mpBurn）
table ServerMobAttackPlayer {
    mob_index:uint32;
    client_id:uint64;
    payload:Attack;
    flags:uint8;
}

// 怪物打怪物（被迷惑的怪互殴）：mob_index 是受害者，from_index 是攻击者。
// 伤害由服务端结算，payload 只用于客户端飘字表现。
table ServerMobHitMob {
    mob_index:uint32;
    from_index:uint32;
    payload:Attack;
}

// 怪物特效（v95 sEffect / sHit / sBall / areaWarning / MobSkill effect）：
// kind 0 = Mob.wz（path 形如 "<mobid>.img/attack1/info/effect"），
// kind 1 = Skill.wz（path 形如 "MobSkill/120.img/level/1/effect"）。
// x/y 是世界坐标，delay 是从收到事件算起的延迟（毫秒）。
// move_ms > 0 表示飞行体（子弹）：从 (x,y) 匀速移动到 (x2,y2)，
// 期间帧循环播放，到点后销毁。
table ServerMobEffect {
    mob_index:uint32;
    kind:uint8;
    path:string;
    x:float;
    y:float;
    x2:float;
    y2:float;
    move_ms:uint64;
    flip:bool;
    delay:uint64;
}

union MobEventUnion {
    ServerMobMv,
    ServerMobFlip,
    ServerMobAction,
    ServerMobState,
    ServerMobDie,
    ServerMobDrop,
    ServerMobAttackPlayer,
    ServerMobHitMob,
    ServerMobEffect,
}

table ServerMobEvent {
    map_id:uint32;
    payload:[MobEventUnion];
}

table ServerCharacterAttack {
    client_id:uint64;
    payload:[CharacterAttack];
}

table ServerCharacterSkill {
    ski_id:uint32;
    ski_lv:uint8;
    client_id:uint64;
    payload:[CharacterSkill];
    x:int32;
    y:int32;
    flip:bool;
}

table ServerCharacterBall {
    client_id:uint64;
    payload:CharacterBall;
}

table ServerMobAttack {
    client_id:uint64;
    payload:Attack;
}

table ServerCharacterChat {
    client_id:uint64;
    name:[uint16];
    payload:CharacterChat;
}

// 其他玩家的宠物（095 CPet）：item_id=0 且 active=false 表示该玩家没有宠物/已离开。
table ServerCharacterPet {
    client_id:uint64;
    pet:PetSave;
}

// 其他玩家宠物的动作/气泡（095 CPet::DoAction）。
// action="warp" 表示跟丢拉回特效：x/y 是旧位置（特效在旧位置播放）。
table ServerCharacterPetAction {
    client_id:uint64;
    action:string;
    chat:[uint16];
    x:float;
    y:float;
}

// 其他玩家宠物的位置/动画同步（095 CPet 的移动包）。
table ServerCharacterPetMove {
    client_id:uint64;
    x:float;
    y:float;
    page:uint8;
    flip:bool;
    action:string;
    ani_index:uint32;
}

table ServerCharacterDrop {
    client_id:uint64;
    payload:Drop;
}

table ServerCharacter {
    client_id:uint64;
    payload:Character;
}

table ServerCharacterPick {
    client_id:uint64;
    random_id:uint64;
    pet:bool;
    pet_index:int8;
}

table ServerCharacterInfo {
   payload:Character;
}

table ServerCharacterTrade {
   step:uint8;
   player:Player;
   payload:[ItemUnion];
   // 交易金币（meso）报价
   meso:uint64;
}


table ServerCharacterMv {
    client_id:uint64;
    payload:Movement;
}

table ServerCharacterFlip {
    client_id:uint64;
    payload:Flip;
}

table ServerCharacterAction {
    client_id:uint64;
    payload:Action;
}

table ServerCharacterDie {
    client_id:uint64;
    payload:Die;
}

table ServerCharacterFc {
    client_id:uint64;
    payload:Face;
}

// 组队状态同步（095 CP 145 / SP 146 PartyResult）。
table ServerCharacterParty {
    step:uint8;    // 5=邀请弹窗(to_id=邀请人)
                   // 7=全量队伍(players 含自己，队长在首位)
                   // 内部字段复用：x=1 被踢 / 0 主动离队（step12）
                   // 12=成员变动(x:1=自己被踢 0=离队/解散; player=变动者)
                   // 15=新成员加入(player=加入者)
                   // 16=已邀请提示(player=被邀请人)
                   // 17=已在其它队 18=队伍已满 19=对方拒绝(to_id=拒绝者)
    to_id:uint64;
    player:Player;
    players:[Player];
    x:uint8;
    hp:[uint32];   // 与 players 对齐的当前 HP（全量/变动包）
    max_hp:[uint32];
}

table ServerCharacterState {
    client_id:uint64;
    payload:[State];
}

table ServerDropFade {
    drop_ids:[uint64];
}

table ServerReactor {
    payload:Reactor;
}

table ServerReactorDrop {
    payload:[Drop];
}

table ServerCharacterLvUp {
    client_id:uint64;
}

table ServerCreateMob {
    mobs:[Mob];
}

table ServerTrapAttack {
    client_id:uint64;
    payload:Attack;
}

table ServerRSkill {
    payload:[RSkill];
}

table ServerMobDebuff {
    payload:[MobDebuff];
}

table ServerCreateDrop {
    payload:[Drop];
}

// 小游戏（五子棋）房间状态同步
table ServerCharacterMinigame {
    step:uint8;          // 0=房间建立(你是房主) 1=对手进入 2=对手离开/房间解散
                         // 3=开局 4=落子 5=结果 6=对方就绪状态 7=聊天
                         // 8=悔棋请求 9=悔棋结果 10=求和请求 11=求和答复
                         // 12=进入失败提示
    player:Player;       // 对手 / 或聊天发送者
    x:uint8;             // 列 / 答复值 / 结果胜者色(2=平局)
    y:uint8;             // 行 / 悔棋移除数
    color:uint8;         // 棋色(0=黑 1=白) / 当前行棋方 / 就绪标记
    chat:[uint16];       // 聊天内容(聊天/失败原因)
    win:uint32;          // 本方战绩：胜
    lose:uint32;         // 本方战绩：负
    draw:uint32;         // 本方战绩：平
    // MatchCards（卡片配对）专用：
    // step 3 开局：cards=洗好的牌面数组(0-14成对)，color=本人slot，y=卡数，x=先手slot
    // step 13 翻开一张：x=卡索引，y=牌面值，color=当前行动者slot
    // step 14 配对成功：x,y=两张卡索引
    // step 15 配对失败/换手：x,y=两张卡索引(255=无卡)，color=换手后行动者slot
    cards:[uint8];
}

// 人物摆摊状态同步（095 CPersonalShopDlg）。
table ServerCharacterShop {
    step:uint8;          // 0=开摊成功（摊位标记，chat=店名）
                         // 1=进店成功（player=摊主，chat=店名，goods=货架）
                         // 2=购买结果（x:1成功 0失败；y=失败原因 0=钱不够 1=货架空/无效
                         //   2=背包满；meso=买家当前金币）
                         // 3=撤摊/离店（to_id=摊主）
                         // 4=售出通知（摊主收：x=货架序号 y=卖出数量 meso=本次收入）
                         // 5=摊位广播（同图玩家：player=摊主，chat=店名，开/撤都发，x:1=开 0=撤）
                         // 6=提示（chat=文本：对方没摆摊等）
                         // 7=店内聊天（player=发送者，chat=内容）
    to_id:uint64;        // 摊主 client_id
    player:Player;       // 摊主
    x:uint8;
    y:uint32;
    meso:uint64;         // 金币（购买后买家余额 / 摊主收入）
    chat:[uint16];       // 店名 / 提示文本
    goods:[ShopGoods];   // 货架（进店时）
}

// MapleChat 聊天室同步（095 CUIMessenger，SP 143 子码 0-8）。
table ServerCharacterMessenger {
    step:uint8;          // 0=成员进入（player=进入者，x=slot；095 OnEnter）
                         // 1=自己进入结果（x=自己slot；players=全员快照按下标=slot；
                         //   x=255=进入失败"不能参与受招待的聊天房"；095 OnSelfEnterResult）
                         // 2=成员离开（player=离开者，to_id=离开者id，x=slot；095 OnLeave）
                         // 3=邀请弹窗（player=邀请人，to_id=房间SN；095 OnInvite）
                         // 4=邀请回执（player=目标：x:1=已发出邀请 0=找不到玩家
                         //   2=已在聊天室 3=聊天室已满；095 OnInviteResult）
                         // 5=对方拒绝（player=拒绝者：x:0=拒绝邀请 1=拒绝聊天状态；095 OnBlocked）
                         // 6=聊天（player=发送者，chat=文本）/
                         //   打字状态（chat空，x:1=正在输入 0=停止；095 OnChat）
    to_id:uint64;
    player:Player;
    players:[Player];
    x:uint8;
    chat:[uint16];
}